      "name": "If Has Previous Summaries To Delete"
    },
    {
      "parameters": {
        "jsCode": "const folderName = $('Loop Over Cloud Folders').item.json.name;\nconst items = $input.all();\nconst timestamp = $now.toFormat('yyyy-MM-dd_HH-mm-ss');\n\n// Find old summaries to delete (comma-separated paths)\nconst oldSummaries = items\n  .filter(item => {\n    const name = item.json.name || '';\n    return name.match(/^CONTENT_SUMMARY_.*\\.md$/);\n  })\n  .map(item => '/' + folderName + '/' + item.json.name);\n\nconst pathsToDelete = oldSummaries.join(', ');\n\n// Build tree (excluding old summaries)\nconst buildTree = (items) => {\n  const tree = {};\n  \n  items.forEach(item => {\n    const name = item.json.name || '';\n    if (name.match(/^CONTENT_SUMMARY_.*\\.md$/)) return;\n    \n    const href = item.json.href || '';\n    const pathMatch = href.match(/\\/ServicesPortal\\/webdav\\/(.+)/);\n    const fullPath = pathMatch ? decodeURIComponent(pathMatch[1]) : name;\n    const relativePath = fullPath.replace(new RegExp('^' + folderName + '/?'), '');\n    const isFolder = item.json.isFolder === true;\n    \n    if (relativePath) {\n      tree[relativePath] = { isFolder, name: relativePath.split('/').pop() };\n    }\n  });\n  \n  return tree;\n};\n\nconst tree = buildTree(items);\nconst sortedPaths = Object.keys(tree).sort();\n\nconst treeLines = [];\nsortedPaths.forEach(path => {\n  const info = tree[path];\n  const depth = (path.match(/\\//g) || []).length;\n  const indent = '    '.repeat(depth);\n  const icon = info.isFolder ? '[DIR]  ' : '[FILE] ';\n  treeLines.push(indent + icon + info.name);\n});\n\nconst folderCount = Object.values(tree).filter(t => t.isFolder).length;\nconst fileCount = Object.values(tree).filter(t => !t.isFolder).length;\n\nconst summary = [\n  '# Contents of /' + folderName,\n  '',\n  'Generated: ' + $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n  '',\n  '---',\n  '',\n  '## Summary',\n  '',\n  '- Total items: ' + Object.keys(tree).length,\n  '- Folders: ' + folderCount,\n  '- Files: ' + fileCount,\n  '',\n  '---',\n  '',\n  '## Directory Tree',\n  '',\n  ...treeLines,\n  '',\n  '---',\n  '',\n  'Generated by CTERA n8n Workflow'\n].join('\\n');\n\nreturn [{ \n  json: { \n    folderName,\n    summary,\n    fileName: 'CONTENT_SUMMARY_' + timestamp + '.md',\n    pathsToDelete: pathsToDelete,\n    hasFilesToDelete: oldSummaries.length > 0\n  } \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
